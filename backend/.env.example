APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEEPSEEK_BASE_URL=https://api.deepseek.com
# Fudan gateway: set the exact endpoint and use appkey authentication.
# DEEPSEEK_ENDPOINT_URL=https://api.fudan.edu.cn/gw_ai_agent/v1/deepseek_v4_flash
DEEPSEEK_ENDPOINT_URL=
DEEPSEEK_AUTH_MODE=bearer
DEEPSEEK_API_KEY=
DEEPSEEK_GENERATION_MODEL=deepseek-chat
DEEPSEEK_TABLE_NOTICE_MODEL=deepseek-chat
DEEPSEEK_FILTER_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_TIMEOUT_SECONDS=120

UIS_OAUTH_CLIENT_ID=
UIS_OAUTH_CLIENT_SECRET=
UIS_OAUTH_AUTHORIZATION_URL=https://id.fudan.edu.cn/idp/authCenter/authenticate
UIS_OAUTH_TOKEN_URL=https://id.fudan.edu.cn/idp/api/v3/oauth2/token
UIS_OAUTH_USER_INFO_URL=https://id.fudan.edu.cn/idp/api/v3/oauth2/userInfo
UIS_OAUTH_LOGOUT_URL=https://id.fudan.edu.cn/idp/authCenter/GLO
UIS_OAUTH_REDIRECT_URI=https://lushangstudio.fudan.edu.cn/api/auth/callback
AUTH_FRONTEND_URL=https://lushangstudio.fudan.edu.cn
AUTH_SESSION_SECRET=
AUTH_SESSION_COOKIE_NAME=lushangstudio_session
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
AUTH_STATE_TTL_SECONDS=600
AUTH_UNDERGRADUATE_ALLOWLIST=

MAX_UPLOAD_MB=20
